  "helpers_js": {
    "bestStreak": "function bestStreak(l){const days=new Set(l.map(e=>e.date));const key=[...days].sort().join();if(BS_MEMO.k===key)return BS_MEMO.v;let b=0;days.forEach(s=>{b=Math.max(b,streakInfo(days,parse(s)).n)});BS_MEMO={k:key,v:b};return b}",
    "maxMonthDays": "function maxMonthDays(l){const m={};new Set(l.map(e=>e.date)).forEach(d=>{const k=d.slice(0,7);m[k]=(m[k]||0)+1});return Math.max(0,...Object.values(m))}",
    "achDays": "l=>[...new Set(l.map(e=>e.date))].sort()",
    "achFullMonth": "function achFullMonth(l){const m={};achDays(l).forEach(d=>{const k=d.slice(0,7);m[k]=(m[k]||0)+1});let best=[0,30],br=-1;\n  for(const k in m){const dim=new Date(+k.slice(0,4),+k.slice(5,7),0).getDate(),r=m[k]/dim;if(r>br){br=r;best=[m[k],dim]}}return best}",
    "achGap": "function achGap(l){const D=achDays(l).map(d=>dnOf(parse(d)));let g=0;for(let i=1;i<D.length;i++)g=Math.max(g,D[i]-D[i-1]-1);return g}",
    "achMaxPerDay": "function achMaxPerDay(l){const m={};l.forEach(e=>m[e.date]=(m[e.date]||0)+1);return Math.max(0,...Object.values(m))}",
    "achMoodRun": "function achMoodRun(l,ok){const by={};l.forEach(e=>(by[e.date]=by[e.date]||[]).push(e.mood??2));let best=0,run=0,prev=null;\n  achDays(l).forEach(d=>{const n=dnOf(parse(d)),v=by[d].reduce((a,b)=>a+b,0)/by[d].length;if(ok(v)){run=prev!=null&&n-prev===1&&run?run+1:1;best=Math.max(best,run)}else run=0;prev=n});return best}",
    "achRebound": "function achRebound(l){const A=l.slice().sort((a,b)=>(a.date+(a.time||'')).localeCompare(b.date+(b.time||'')));\n  for(let i=0;i<A.length;i++){if((A[i].mood??2)>1)continue;const d0=dnOf(parse(A[i].date));for(let j=i+1;j<A.length;j++){const dd=dnOf(parse(A[j].date))-d0;if(dd>3)break;if((A[j].mood??2)>=3)return true}}return false}",
    "achAnniv": "function achAnniv(l){const S=new Set(l.map(e=>e.date));return l.some(e=>{const y=+e.date.slice(0,4)-1;return S.has(y+e.date.slice(4))})}",
    "achSpan": "function achSpan(l){const D=achDays(l);return D.length<2?0:dnOf(parse(D[D.length-1]))-dnOf(parse(D[0]))}",
    "consState": "function consState(list){const order=prof.conOrder||(prof.conOrder=[]);let rem=list.length,i=0,changed=false;const done=[];\n  for(;;){if(i>=order.length){const nx=pickNext(order);if(!nx){if(changed)saveProf();return{done,cur:null,lit:0,off:list.length}}order.push(nx);changed=true;if(nx===prof.nextPick)prof.nextPick=null}\n    const n=CON[order[i]].s.length;if(rem>=n){done.push(order[i]);rem-=n;i++}else break}\n  if(changed)saveProf();return{done,cur:order[i],lit:rem,off:list.length-rem}}",
    "achLeft": "function achLeft(id,n){n=Math.max(0,n);const f={s3:`再連續寫 ${n} 天就能解鎖`,s7:`再連續寫 ${n} 天就能解鎖`,first:`寫下第一則就能解鎖`,c10:`再寫 ${n} 則就能解鎖`,photo:`再 ${n} 則附上照片或影片就能解鎖`,loc:`再 ${n} 則加上地點就能解鎖`,\n  words:`再寫 ${n.toLocaleString()} 字就能解鎖`,signal:`再回答 ${n} 次今日星語就能解鎖`,all:`再用 ${n} 種沒用過的心情就能解鎖`,con1:`再完成 ${n} 個星座就能解鎖`,con5:`再完成 ${n} 個星座就能解鎖`,s100:`再連續寫 ${n} 天就能解鎖`,s60:`再連續寫 ${n} 天就能解鎖`,mfull:`這個月再寫 ${n} 天就能解鎖`,back:`休息一陣子後再回來寫，就能解鎖`,c365:`再寫 ${n} 則就能解鎖`,w50k:`再寫 ${n.toLocaleString()} 字就能解鎖`,long1k:`單則再多寫 ${n.toLocaleString()} 字就能解鎖`,multi:`同一天再寫 ${n} 則就能解鎖`,photo4:`單則再加 ${n} 張照片就能解鎖`,fav5:`再收藏 ${n} 則就能解鎖`,season4:`再到 ${n} 個季節寫紀錄就能解鎖`,happy3:`再連續 ${n} 天好心情就能解鎖`,bright10:`再記錄 ${n} 次「很棒」就能解鎖`,calm10:`再記錄 ${n} 次「還可以」就能解鎖`,low5:`難過的日子也寫下來，再 ${n} 次就能解鎖`,rebound:`低落之後心情回升時就能解鎖`,rev1:`回顧一則舊紀錄就能解鎖`,rev10:`再回顧 ${n} 則就能解鎖`,rev30:`再回顧 ${n} 則就能解鎖`,anniv:`一年後的同一天再寫一則就能解鎖`,j100:`再繼續寫 ${n} 天就能解鎖`,j365:`再繼續寫 ${n} 天就能解鎖`,con44:`再完成 ${n} 個星座就能解鎖`,zod12:`再完成 ${n} 個黃道星座就能解鎖`,con88:`再完成 ${n} 個星座就能解鎖`,s14:`再連續寫 ${n} 天就能解鎖`,s30:`再連續寫 ${n} 天就能解鎖`,m20:`這個月再寫 ${n} 天就能解鎖`,c30:`再寫 ${n} 則就能解鎖`,c100:`再寫 ${n} 則就能解鎖`,long:`單則再多寫 ${n} 字就能解鎖`,photo20:`再 ${n} 則附上照片就能解鎖`,loc10:`再去 ${n} 個新地點就能解鎖`,tag5:`再用 ${n} 種新標籤就能解鎖`,signal10:`再回答 ${n} 次今日星語就能解鎖`,night:`再 ${n} 則在晚上 10 點後寫就能解鎖`,early:`再 ${n} 則在早上 8 點前寫就能解鎖`,con3:`再完成 ${n} 個星座就能解鎖`,con10:`再完成 ${n} 個星座就能解鎖`,w20k:`再寫 ${n.toLocaleString()} 字就能解鎖`,w5k:`再寫 ${n.toLocaleString()} 字就能解鎖`,zod1:`完成一個黃道十二星座就能解鎖`,con20:`再完成 ${n} 個星座就能解鎖`}[id];return f||`還差 ${n}`}",
    "chars": "e=>((e.title||'')+(e.body||'')).replace(/\\s/g,'').length"
  },
  "_note": "54 badges in 6 sections (each a multiple of 3). crystal_colors = [main, highlight, shadow] per crystal_category. unlock_test_js / progress_js are the original JS (l = entries array); progress returns [current, target]. Helper sources are in helpers_js."
